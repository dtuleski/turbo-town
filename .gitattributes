# Normalize line endings across machines (Windows + macOS/Linux).
# Text files are stored with LF in the repo and checked out natively.
* text=auto

# Source & config -> always LF in the working tree too, to avoid churn.
*.dart      text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.md        text eol=lf

# Shell scripts MUST be LF (they run under bash on macOS/Linux/CI).
*.sh        text eol=lf

# Windows-only scripts stay CRLF.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary assets — never touch.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.zip       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
