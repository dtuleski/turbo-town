  "circuitBuilder_level_cb_01_closed_circuit_title": "Close the loop",
  "circuitBuilder_level_cb_01_closed_circuit_goal": "Light the rover headlight.",
  "circuitBuilder_level_cb_01_closed_circuit_hint": "Join the battery, the resistor and the LED bulb in a ring, and bring a wire back to the battery. If the bulb stays dark, check which way round it is connected.",
  "circuitBuilder_level_cb_01_closed_circuit_learn": "Current only flows around a closed loop. The resistor protects the LED bulb from too much current.",
  "circuitBuilder_level_cb_02_switch_control_title": "Switch it on",
  "circuitBuilder_level_cb_02_switch_control_goal": "Light the headlight with the switch closed, then turn it off and on again.",
  "circuitBuilder_level_cb_02_switch_control_hint": "The switch is already on the board. Put it in the loop with the battery, the resistor and the LED bulb, then select it to open or close it.",
  "circuitBuilder_level_cb_02_switch_control_learn": "A switch opens or closes the loop. When it is open the loop is cut, no current flows and the light goes out.",
  "circuitBuilder_level_cb_03_series_loop_title": "One loop for two",
  "circuitBuilder_level_cb_03_series_loop_goal": "Light the headlight and sound the buzzer in the same loop.",
  "circuitBuilder_level_cb_03_series_loop_hint": "Put the LED bulb and the buzzer one after the other in the same loop, with the resistor and the switch. Then open the switch and watch both.",
  "circuitBuilder_level_cb_03_series_loop_learn": "In a series circuit the same current goes through every part, one after the other. Open the switch and everything stops.",
  "circuitBuilder_level_cb_04_parallel_branches_title": "Two paths",
  "circuitBuilder_level_cb_04_parallel_branches_goal": "Give the headlight one path and the buzzer another, each with its own switch.",
  "circuitBuilder_level_cb_04_parallel_branches_hint": "Connect both paths to the same battery terminals. Each path has its own switch. Open one and see what the other does.",
  "circuitBuilder_level_cb_04_parallel_branches_learn": "In a parallel circuit each path is its own loop. Switching one off leaves the other running.",
  "circuitBuilder_level_cb_05_series_vs_parallel_title": "Power the whole rover",
  "circuitBuilder_level_cb_05_series_vs_parallel_goal": "Run the motors, the headlight and the buzzer at the same time.",
  "circuitBuilder_level_cb_05_series_vs_parallel_hint": "Wire the parts side by side, each one straight across the battery, with the resistor in front of the LED bulb. Motors in one series loop turn very slowly.",
  "circuitBuilder_level_cb_05_series_vs_parallel_learn": "Parts side by side each get the full battery voltage. Parts in series share it, so motors in series get less and turn more slowly.",
  "circuitBuilder_level_cb_06_short_circuit_recovery_title": "Beat the short circuit",
  "circuitBuilder_level_cb_06_short_circuit_recovery_goal": "Light the headlight even if a short circuit blows the fuse first.",
  "circuitBuilder_level_cb_06_short_circuit_recovery_hint": "A wire straight across the battery blows the fuse. Reset the fuse, take that wire away and put the load back in the loop.",
  "circuitBuilder_level_cb_06_short_circuit_recovery_learn": "A path with almost no resistance lets a huge current through. Always keep a load in the loop, and reset the fuse once the fault is fixed.",
  "circuitBuilder_level_cb_07_resistance_limits_current_title": "Tame the current",
  "circuitBuilder_level_cb_07_resistance_limits_current_goal": "Light the LED with a safe current, using the battery and LED already on the board.",
  "circuitBuilder_level_cb_07_resistance_limits_current_hint": "Put a resistor in series with the LED. Two resistors in series add up. Two in parallel give less resistance than one, so more current flows.",
  "circuitBuilder_level_cb_07_resistance_limits_current_learn": "Current is voltage divided by resistance. More resistance means less current, and resistors in parallel lower the total resistance.",
  "circuitBuilder_level_cb_08_variable_voltage_title": "Find the right voltage",
  "circuitBuilder_level_cb_08_variable_voltage_goal": "Power the motor, the buzzer and the headlight from one battery, and find which supply voltages work.",
  "circuitBuilder_level_cb_08_variable_voltage_hint": "Close the master switch and the headlight switch. Change the supply voltage with the slider: the motor needs enough voltage to turn, and the LED can get too much current if it is high.",
  "circuitBuilder_level_cb_08_variable_voltage_learn": "Voltage pushes current through resistance. If it is too low the motor will not turn. If it is too high the LED carries more current than it is rated for.",
